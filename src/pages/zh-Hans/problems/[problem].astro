---
import Base from '../../../layouts/Base.astro';
import '../../../styles/content.css';
import '../../../styles/b.css';
import { bCopy, definitions } from '../../../lib/b-copy';
import {
  hubsForProblem,
  lineageForProblem,
  originsForProblem,
  papersForProblem,
  problemByKey,
  problemsBySize,
} from '../../../lib/b';
import HubTable from '../../../components/b/HubTable.astro';
import OriginList from '../../../components/b/OriginList.astro';
import PaperTable from '../../../components/b/PaperTable.astro';
import LineageCallout from '../../../components/b/LineageCallout.astro';
import StateMark from '../../../components/b/StateMark.astro';
import { withBase } from '../../../lib/urls';
import { githubIssuesUrl } from '../../../lib/site';

export function getStaticPaths() {
  return problemsBySize.map((p) => ({ params: { problem: p.key } }));
}

const lang = 'zh';
const key = Astro.params.problem!;
const p = problemByKey(key)!;
const c = bCopy[lang].detail;
const definition = definitions[key].zh;
const hubs = hubsForProblem(key);
const origins = originsForProblem(key);
const papers = papersForProblem(key, 'all');
const lineage = lineageForProblem(key);
const stateText = (bCopy[lang].state as Record<string, string>)[key];
const title = `${p.name_zh} · 问题族 · C4AI Atlas`;
const description = definition.split('。').slice(0, 2).join('。') + '。';
const sections = [
  ['definition', c.sections.definition],
  ['hubs', c.sections.hubs],
  ['origins', c.sections.origins],
  ['papers', c.sections.papers],
  ...(lineage ? [['lineage', c.sections.lineage]] : []),
  ['limits', c.sections.limits],
] as Array<[string, string]>;
const limits = c.limits.map((s) => s.replace('{n_method}', String(p.n_method)).replace('{n_edges}', String(p.n_edges)));
---
<Base
  lang={lang}
  title={title}
  description={description}
  alternateHref={`/problems/${key}/`}
  switchHref={`/problems/${key}/`}
>
  <div class="wrap content b-page">
    <a class="b-back mono" href={withBase('/zh-Hans/problems/')}>← {c.breadcrumb}</a>

    <header class="page-head b-detail-head">
      <div>
        <div class="b-eyebrow">
          <span class="b-mark"><span class="b-mark__rule" aria-hidden="true"></span>{bCopy[lang].layer} / {c.breadcrumb}</span>
          <span class="mono b-key">{key}</span>
        </div>
        <h1>{p.name_zh}</h1>
        <p class="b-alt-name">{p.name_en}</p>
        <p class="b-state-line">
          <StateMark status={p.status} edges={p.n_edges} lang={lang} word={false} showCount={false} />
          <span>{stateText}</span>
        </p>
      </div>
      <aside class="page-facts" aria-label="问题族事实">
        <dl>
          <dt>{c.metricMethod}</dt><dd>{p.n_method}</dd>
          <dt>{c.metricLabelled}</dt><dd>{p.n_labelled}</dd>
          <dt>{c.metricEdges}</dt><dd>{p.n_edges}</dd>
          <dt>{c.metricOrigins}</dt><dd>{p.n_origins}</dd>
        </dl>
      </aside>
    </header>

    <nav class="page-toc" aria-label={c.toc}>
      {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>

    <section id="definition">
      <div class="sec-head">
        <div><h2>{c.sections.definition}</h2></div>
        <p>{definition}</p>
      </div>
    </section>

    <section id="hubs">
      <div class="sec-head">
        <div><h2>{c.sections.hubs}</h2></div>
        <p>{c.hubsNote}</p>
      </div>
      {hubs.length > 0 ? (
        <HubTable hubs={hubs} total={hubs.length} key={key} lang={lang} />
      ) : (
        <div class="b-empty">
          <p class="b-empty__title">{bCopy[lang].empty.noHubsTitle}</p>
          <p>{bCopy[lang].empty.noHubs}</p>
          <a class="text-link" href="#papers">{lang === 'zh' ? '查看族内论文' : 'See the papers in this family'} ↓</a>
        </div>
      )}
    </section>

    <section id="origins">
      <div class="sec-head">
        <div><h2>{c.sections.origins}</h2></div>
        <p>{c.originsNote}</p>
      </div>
      {origins.length > 0 ? <OriginList origins={origins} lang={lang} /> : (
        <div class="b-empty"><p>{bCopy[lang].empty.noOrigins}</p></div>
      )}
    </section>

    <section id="papers">
      <div class="sec-head">
        <div><h2>{c.sections.papers}</h2></div>
        <p>{c.papersNote(p.n_labelled, p.n_method)}</p>
      </div>
      <PaperTable papers={papers} methodCount={p.n_method} labelledCount={p.n_labelled} origins={origins} problemKey={key} lang={lang} />
    </section>

    {lineage && (
      <section id="lineage">
        <div class="sec-head">
          <div><h2>{c.sections.lineage}</h2></div>
          <p>{c.lineageNote}</p>
        </div>
        <LineageCallout caseKey={key} data={lineage} lang={lang} />
      </section>
    )}

    <section id="limits">
      <div class="sec-head">
        <div><h2>{c.limitsTitle}</h2></div>
      </div>
      <ul class="prose">
        {limits.map((line) => <li>{line}</li>)}
      </ul>
      <p class="b-limit-links">
        <a href={withBase('/zh-Hans/download/')}>{c.limitsLinks[1]}</a>
        {' · '}
        <a href={githubIssuesUrl}>{c.limitsLinks[2]}</a>
      </p>
    </section>

    <footer class="b-page-foot">
      <p class="mono">{bCopy[lang].labels.schema}</p>
    </footer>
  </div>
</Base>
