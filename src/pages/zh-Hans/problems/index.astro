---
import Base from '../../../layouts/Base.astro';
import '../../../styles/content.css';
import '../../../styles/b.css';
import { bCopy } from '../../../lib/b-copy';
import { problemsBySize } from '../../../lib/b';
import ProblemRow from '../../../components/b/ProblemRow.astro';
import { withBase } from '../../../lib/urls';

const lang = 'zh';
const c = bCopy[lang].index;
const title = '语料中的八个问题族 · C4AI Atlas';
const description = 'C4AI Atlas B 层的八个问题族，覆盖 426 篇方法论文。列出问题标签、族内引用、枢纽和起源候选。';
---
<Base
  lang={lang}
  title={title}
  description={description}
  alternateHref="/problems/"
  switchHref="/problems/"
>
  <div class="wrap content b-page">
    <header class="page-head b-index-head">
      <div class="b-eyebrow">
        <span class="b-mark"><span class="b-mark__rule" aria-hidden="true"></span>{bCopy[lang].layer} / {c.eyebrow.split(' / ').pop()}</span>
      </div>
      <h1>{c.title}</h1>
    </header>

    <section class="b-key" aria-labelledby="b-key-title">
      <p class="eyebrow" id="b-key-title">{c.keyTitle}</p>
      <div class="b-key__list">
        <span class="b-key__item"><span class="b-state b-state--connected"><span class="b-state__glyph" aria-hidden="true"><i></i><i></i><i></i></span><span class="b-state__word">{c.keyConnected}</span></span></span>
        <span class="b-key__item"><span class="b-state b-state--thin"><span class="b-state__glyph" aria-hidden="true"><i></i><i></i><i></i></span><span class="b-state__word">{c.keyThin}</span></span></span>
        <span class="b-key__item"><span class="b-state b-state--no_in_family_edges"><span class="b-state__glyph" aria-hidden="true"><i></i><i></i><i></i></span><span class="b-state__word">{c.keyNone}</span></span></span>
      </div>
      <div class="b-key__notes">
        {c.howToRead.map((line) => <p>{line}</p>)}
      </div>
    </section>

    <section id="families" aria-labelledby="families-title">
      <div class="sec-head b-list-head">
        <div>
          <p class="eyebrow">{c.sectionEyebrow}</p>
          <h2 id="families-title">{c.sectionTitle}</h2>
        </div>
        <p>{c.sectionNote}</p>
      </div>
      <div class="b-problem-head mono" aria-hidden="true">
        <span>序号</span><span>{c.colFamily}</span><span>{c.colHub}</span><span>{c.colMethod}</span><span>{c.colOrigins}</span><span>{c.colState}</span>
      </div>
      <ol class="b-problem-list" aria-labelledby="families-title">
        {problemsBySize.map((p, i) => <ProblemRow problem={p} ordinal={i + 1} lang={lang} />)}
      </ol>
    </section>

    <footer class="b-page-foot">
      <p class="mono">{bCopy[lang].labels.schema}</p>
      <p>
        <a href={withBase('/zh-Hans/download/')}>{c.coverageLinks[1]}</a>
      </p>
    </footer>
  </div>
</Base>
