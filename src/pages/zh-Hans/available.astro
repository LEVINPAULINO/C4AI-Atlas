---
import ContentPage from '../../components/ContentPage.astro';
import '../../styles/available.css';

const lang = 'zh';
const c = {
  title: '可获取内容 · C4AI Atlas',
  description: 'C4AI Atlas 的完整编码文本库和编码 skill。链接暂未开放。',
  eyebrow: '资源',
  heading: '可获取内容',
  lede: '两项内容正在整理，链接将在准备好后补上。',
  items: [
    {
      n: '01',
      title: '完整编码文本库',
      body: '用于编码的论文全文库，包含每个标签对应的原文段落。',
    },
    {
      n: '02',
      title: '编码 skill',
      body: '位于 .opencode/skills/c4ai-corpus-coding 的编码 skill，用于筛选论文和生成编码记录。',
    },
  ],
  pending: '暂未开放链接',
};
---
<ContentPage
  lang={lang}
  slug="/available/"
  title={c.title}
  description={c.description}
  eyebrow={c.eyebrow}
  heading={c.heading}
  lede={c.lede}
>
  <section id="resources">
    <ol class="resource-list">
      {c.items.map((item) => (
        <li class="resource-row">
          <span class="resource-row__n mono">{item.n}</span>
          <div class="resource-row__body">
            <h2>{item.title}</h2>
            <p>{item.body}</p>
          </div>
          <span class="resource-row__status mono">{c.pending}</span>
        </li>
      ))}
    </ol>
  </section>
</ContentPage>
