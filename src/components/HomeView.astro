---
import { atlas } from '../lib/atlas';
import { t, type Lang } from '../lib/i18n';
import { labels } from '../lib/labels';
import FingerprintWall from './FingerprintWall.astro';
import PatternPreview from './PatternPreview.astro';
import TimelineChart from './TimelineChart';
import { withBase } from '../lib/urls';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const c = t(lang);
const prefix = lang === 'zh' ? '/zh-Hans' : '';
const p0Caps = atlas.capabilities.filter((cap) => cap.priority === 'P0');
const built = atlas.meta.built_at.slice(0, 10);
const versionLine = lang === 'zh'
  ? `数据 v${atlas.meta.version}，${built} 生成`
  : `Data v${atlas.meta.version}, built ${built}`;
---
<div class="wrap">
  <section class="hero">
    <p class="eyebrow hero__eyebrow">
      <span class="hero__dot" aria-hidden="true"></span>
      {c.hero.eyebrow}
    </p>
    <h1 class={lang === 'zh' ? 'hero__title hero__title--zh' : 'hero__title'}>{c.hero.title}</h1>
    <p class="hero__deck">{c.hero.deck}</p>
    <div class="hero__side">
      <p class="hero__body">{c.hero.body}</p>
      <div class="hero__meta">
        {c.hero.meta.map((m) => <span>{m}</span>)}
      </div>
      <div class="hero__actions">
        <a class="button" href={withBase(`${prefix}/explore/`)}>{c.hero.cta}</a>
        <a class="text-link" href={withBase(`${prefix}/methods/`)}>{c.hero.methods}</a>
      </div>
      <p class="live-note hero__live"><span class="live-dot" aria-hidden="true"></span>{versionLine}</p>
    </div>
  </section>

  <section class="stats" aria-label={c.statsLabel}>
    {c.stats.map(([value, label]) => (
      <div class="stat">
        <span class="stat__value" data-count={value} data-decimals={value.includes('.') ? 3 : 0}>{value}</span>
        <span class="stat__label">{label}</span>
      </div>
    ))}
  </section>

  <section class="section" id="corpus">
    <div class="section__head">
      <div>
        <p class="eyebrow"><span class="section__index">01</span><span class="sep" aria-hidden="true">/</span>{c.timeline.eyebrow}</p>
        <h2>{c.timeline.title}</h2>
      </div>
      <p class="section__note">{c.timeline.body}</p>
    </div>
    <TimelineChart client:idle lang={lang} />
  </section>

  <section class="section" id="coding">
    <div class="section__head">
      <div>
        <p class="eyebrow"><span class="section__index">02</span><span class="sep" aria-hidden="true">/</span>{c.ledger.eyebrow}</p>
        <h2>{c.ledger.title}</h2>
      </div>
      <p class="section__note">{c.ledger.body}</p>
    </div>
    <FingerprintWall note={c.ledger.wallNote} lang={lang} />
    <div class="section__sub">
      <PatternPreview href={withBase(`${prefix}/explore/`)} label={c.ledger.previewLink} lang={lang} />
    </div>
  </section>

  <section class="section" id="capabilities">
    <div class="section__head">
      <div>
        <p class="eyebrow"><span class="section__index">03</span><span class="sep" aria-hidden="true">/</span>{c.cap.eyebrow}</p>
        <h2>{c.cap.title}</h2>
      </div>
      <p class="section__note">{c.cap.body}</p>
    </div>
    <div class="cap-list">
      {p0Caps.map((cap) => (
        <a class="cap-row" href={withBase(`${prefix}/capabilities/#${cap.id}`)}>
          <span class="mono cap-row__id">{cap.id}</span>
          <span class="cap-row__name">{lang === 'zh' ? cap.name_zh : cap.name}</span>
          <span class="mono cap-row__ready">{labels[lang].readiness[cap.readiness as keyof (typeof labels)['en']['readiness']] ?? cap.readiness}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="deep">
    <div class="section__head">
      <div>
        <p class="eyebrow"><span class="section__index">04</span><span class="sep" aria-hidden="true">/</span>{c.deep.eyebrow}</p>
        <h2>{c.deep.title}</h2>
      </div>
      <p class="section__note">{c.deep.body}</p>
    </div>
    <div class="deep-links">
      <a href={withBase(`${prefix}/deep/#lattice`)}>{c.deep.links[0][0]} <span>{c.deep.links[0][1]}</span></a>
      <a href={withBase(`${prefix}/deep/#umap`)}>{c.deep.links[1][0]} <span>{c.deep.links[1][1]}</span></a>
      <a href={withBase(`${prefix}/deep/#orbital`)}>{c.deep.links[2][0]} <span>{c.deep.links[2][1]}</span></a>
    </div>
  </section>
</div>
