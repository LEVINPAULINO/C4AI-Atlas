---
import { atlas } from '../lib/atlas';
import { describeBits } from '../lib/bits';
interface Props { note?: string; lang?: 'en' | 'zh' }
const { note = '580 glyphs · 8 bits each · outlined = P0 pending · color = coupling level', lang = 'en' } = Astro.props;
const papers = atlas.papers;
---
<div class="glyph-wall" aria-label="580 paper fingerprints, one per paper" role="img">
  {papers.map((p) => (
    <span
      class="glyph"
      data-level={p.level}
      data-p0={p.p0 ? '1' : '0'}
      title={`${p.id} · ${p.level} · ${describeBits(p.bits, lang)}${p.p0 ? ' · P0 pending' : ''}`}
    >
      {p.bits.split('').map((b) => <i data-on={b}></i>)}
    </span>
  ))}
</div>
<p class="mono" style="font-size:0.62rem;color:var(--muted);margin:0.6rem 0 0">
  {note}
</p>
