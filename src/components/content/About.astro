---
import ContentPage from '../ContentPage.astro';
import { atlas } from '../../lib/atlas';
import { dataVersion, protocolVersion, builtDate, shaShort } from '../../lib/content';
import { withBase } from '../../lib/urls';
import { contactEmail, githubIssuesUrl, githubUrl } from '../../lib/site';

interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;

const team = [
  {
    en: ['Product and IA', 'Page map, user journeys, URL state, bilingual content model', 'SKILL.md, DECISIONS.md, page specs'],
    zh: ['产品与信息架构', '页面地图、用户路径、URL 状态、双语内容模型', 'SKILL.md、DECISIONS.md、页面规格'],
  },
  {
    en: ['Visual identity', 'Art direction, palette, type, wordmark, icon grammar, OG', 'Tokens, brand sheet, OG templates'],
    zh: ['视觉识别', '艺术指导、配色、字体、字标、图标语法、OG', 'Tokens、品牌表、OG 模板'],
  },
  {
    en: ['Data visualization', 'Ledger, lattice, UMAP, 3D, UpSet, interaction contract', 'Chart specs, atlas.json schema, table fallback'],
    zh: ['数据可视化', '编码总表、汉明图、UMAP、三维图、UpSet、交互规则', '图表规格、atlas.json 数据结构、表格回退'],
  },
  {
    en: ['Frontend and platform', 'Astro, React islands, Tailwind, GitHub Pages, build', 'site/, Actions, performance budget'],
    zh: ['前端与平台', 'Astro、React islands、Tailwind、GitHub Pages、构建', 'site/、Actions、性能预算'],
  },
  {
    en: ['Editorial and bilingual', 'English and Chinese copy, terminology, citation', 'Page copy, codebook labels, citation blocks'],
    zh: ['编辑与双语', '中英文文案、术语、引用', '页面文案、编码手册标签、引用块'],
  },
  {
    en: ['Copyright and data governance', 'Quote policy, licenses, responsibility page, provenance', 'Responsibility notice, license terms, takedown flow'],
    zh: ['版权与数据治理', '引用政策、许可、责任页、来源链', '责任说明、许可条款、下架流程'],
  },
  {
    en: ['QA', 'Accessibility, data correctness, visual regression, performance', 'Review notes, screenshots, gate report'],
    zh: ['质量保证', '无障碍、数据正确性、视觉回归、性能', '评审记录、截图、评审报告'],
  },
];

const copy = {
  en: {
    title: 'About the C4AI Atlas',
    description:
      'What the project is, the data version, the seven team roles, citation, license, contact, and the bilingual policy.',
    eyebrow: '09 / About',
    heading: 'A coded field guide to causality in AI.',
    lede:
      'C4AI Atlas indexes 580 papers that connect causal methods to AI systems. It publishes the coding, the rules that derive the labels, and the audit trail. It does not publish the papers.',
    factsTitle: 'Project',
    facts: [
      ['Data version', dataVersion],
      ['Protocol', protocolVersion],
      ['Built', builtDate],
      ['Team roles', '7'],
      ['License', 'CC BY 4.0'],
    ] as Array<[string, string]>,
    sections: [
      ['what', 'What it is'],
      ['status', 'Status'],
      ['team', 'Team'],
      ['citation', 'Citation'],
      ['license', 'License'],
      ['contact', 'Contact'],
      ['language', 'Language'],
    ] as Array<[string, string]>,
    whatTitle: 'The unit is a paper. The product is the coding.',
    whatBody:
      'Each paper gets eight bits: five components that describe what causality does in the system, and three positions that describe where it enters. Two labels are derived by rule: a coupling level (L0–L4) and a pipeline position (before, inner, after, or mixed). The rules are public, so a disagreement can point at a bit instead of a vibe.',
    whatList: [
      `${atlas.stats.papers} coded full texts from a 2017–2026 corpus window, across eight families: CausalRL, OOD, CausalRepLearn, TimeSeries, WorldModel, CI_for_LLM, CausalDiscovery, and Agent.`,
      `${atlas.stats.patterns} observed 8-bit patterns out of 256 possible. The modal pattern 11100010 has 72 papers.`,
      '37 canon capabilities, mapped to lifecycle cells with assumptions, interfaces, failure modes, and P0 evidence.',
      'An audit page that states direction, tier, coupling, pipeline, κ, A precision, scale-sweep, and the screening funnel.',
    ],
    whatNote:
      'The central claim is traceability, not causal uplift. The site does not claim that causal methods improve AI by a pooled percentage, and it does not treat a 2D projection as a measurement.',
    statusTitle: 'Provisional, and explicit about it.',
    statusBody:
      'The current snapshot is v0.1.0-provisional, built from the coding before the final adjudicated merge. Ten paper rows are P0 and marked. They are excluded from headline aggregates. A precision (12/20) and the scale-sweep rate (8/353) are provisional for the same reason.',
    statusList: [
      ['Data', dataVersion],
      ['Protocol', protocolVersion],
      ['Built', builtDate],
      ['Data status', 'provisional'],
      ['P0 signed', 'no'],
      ['SHA-256', shaShort],
    ] as Array<[string, string]>,
    teamTitle: 'Seven roles, one gate each.',
    teamBody:
      'The project is organized by decision ownership, not by seniority. Each role owns one class of artifact and one review gate. v0.1 publishes the roles, not a named roster; names and affiliations are a TODO before a formal release.',
    colRole: 'Role',
    colOwns: 'Owns',
    colArtifacts: 'Main artifacts',
    teamNote:
      'The review gates are design, visualization, accessibility, data, copyright, bilingual, performance, and content. A page that fails a gate does not ship.',
    citationTitle: 'Citation.',
    citationBody:
      'Cite the data version, not the site in general. The download page carries a plain citation and a BibTeX block. A DOI is not assigned in v0.1.',
    citationPlain:
      'C4AI Atlas (2026). C4AI Atlas: causality for AI, coded (Version 0.1.0-provisional) [Data set]. Data snapshot 2026-10-27.',
    licenseTitle: 'License.',
    licenseBody:
      'Code is MIT. Annotations, the codebook, and site prose are CC BY 4.0. Metadata sourced from OpenAlex, Crossref, or arXiv is CC0. Quoted third-party text is excluded from the site license.',
    licenseNote:
      'If you reuse a chart, cite the data version and the filter that produced it. If you reuse a quotation, clear it with the rights holder.',
    contactTitle: 'Contact.',
    contactRows: [
      ['Data errors, label disputes', 'GitHub issue form.'],
      ['Copyright, private concerns', contactEmail],
      ['Release notes', 'Newsletter is not connected yet. Email the project for release notes.'],
      ['Repository', 'GitHub'],
    ] as Array<[string, string]>,
    languageTitle: 'Two languages, one data set.',
    languageBody:
      'English is the default. Simplified Chinese is a full mirror under /zh-Hans/, not a machine-translated overlay. The language switch is visible, and there is no JavaScript auto-redirect.',
    languageList: [
      'Translated: UI, methods, codebook bit definitions, capability names, page summaries, and audit captions.',
      'Not translated: paper abstracts. Translating an abstract creates a derivative work, so the site never publishes one.',
      'Paper titles stay in their original language. A translated title, where added, never replaces the original.',
      'Chinese blocks carry lang="zh-Hans". The layout is tested at 320px with the longest labels.',
    ],
    languageNote:
      'The English and Chinese pages share one data file and one set of IDs. A number should never differ between them; if it does, the English page states the current version and the difference is a bug.',
    closeNote:
      'The project is not peer review, not legal advice, and not an endorsement of any paper, author, venue, or method.',
  },
  zh: {
    title: '关于本项目',
    description:
      '项目是什么、数据版本、七个团队角色、引用、许可、联系与双语政策。',
    eyebrow: '09 / 关于',
    heading: '项目说明',
    lede:
      'C4AI Atlas 收录 580 篇连接因果方法与 AI 系统的论文，发布编码、派生规则和数据核查结果。',
    factsTitle: '项目',
    facts: [
      ['数据版本', dataVersion],
      ['协议', protocolVersion],
      ['生成', builtDate],
      ['团队角色', '7'],
      ['许可', 'CC BY 4.0'],
    ] as Array<[string, string]>,
    sections: [
      ['what', '是什么'],
      ['status', '状态'],
      ['team', '团队'],
      ['citation', '引用'],
      ['license', '许可'],
      ['contact', '联系'],
      ['language', '语言'],
    ] as Array<[string, string]>,
    whatTitle: '论文记录与编码',
    whatBody:
      '每篇论文有 8 个编码位：5 位描述因果结构，3 位描述介入阶段。两个标签由编码位推出：耦合程度（L0–L4）和介入阶段（数据、训练、推理、混合）。规则公开，有分歧时可以指出具体哪一位编码。',
    whatList: [
      `${atlas.stats.papers} 篇已编码全文，来自 2017–2026 年，覆盖 8 个论文分组：CausalRL、OOD、CausalRepLearn、TimeSeries、WorldModel、CI_for_LLM、CausalDiscovery 与 Agent。`,
      `256 种可能组合中观察到 ${atlas.stats.patterns} 种。出现最多的组合 11100010 有 72 篇。`,
      '37 条能力，按应用阶段分组，附假设、接口、失效模式和 P0 证据。',
      '数据核查页给出方向、对照强度、耦合程度、介入阶段、一致性、A 档准确率、规模扫描和筛选流程。',
    ],
    whatNote:
      '项目的核心目标是可追溯。本站记录论文报告的性能差值，二维投影用于展示。',
    statusTitle: '数据状态',
    statusBody:
      '当前快照为 v0.1.0 暂定版，来自最终合并前的编码。10 条 P0 记录已标注，不计入首页汇总。A 档准确率（12/20）和规模扫描比例（8/353）同为暂定值。',
    statusList: [
      ['数据', dataVersion],
      ['协议', protocolVersion],
      ['生成', builtDate],
      ['数据状态', '暂定版本'],
      ['P0 已核定', '否'],
      ['SHA-256', shaShort],
    ] as Array<[string, string]>,
    teamTitle: '团队分工',
    teamBody:
      '项目按决策所有权组织。每个角色负责一类产物和一道评审关口。v0.1 公布角色分工；姓名与机构将在正式发布前补齐。',
    colRole: '角色',
    colOwns: '负责',
    colArtifacts: '主要产物',
    teamNote:
      '八道评审关口是：设计、可视化、无障碍、数据、版权、双语、性能、内容。页面通过全部关口后才发布。',
    citationTitle: '引用方式',
    citationBody:
      '引用数据版本，不要只引用站点。下载页提供纯文本引用与 BibTeX。v0.1 尚未分配 DOI。',
    citationPlain:
      'C4AI Atlas（2026）。C4AI Atlas: causality for AI, coded（版本 0.1.0 暂定版）[数据集]。数据快照 2026-10-28。',
    licenseTitle: '许可',
    licenseBody:
      '代码为 MIT。标注、编码手册与站点文字为 CC BY 4.0。来自 OpenAlex、Crossref 或 arXiv 的元数据为 CC0。第三方引用文字不包含在站点许可中。',
    licenseNote:
      '复用图表时，请引用数据版本与生成它的筛选条件。复用引用时，请向权利持有人取得许可。',
    contactTitle: '联系',
    contactRows: [
      ['数据错误、标签争议', 'GitHub 问题表单。'],
      ['版权、私人事务', contactEmail],
      ['发布说明', '订阅尚未接入。可先用邮件联系项目。'],
      ['代码仓库', 'GitHub'],
    ] as Array<[string, string]>,
    languageTitle: '语言版本',
    languageBody:
      '英文是默认语言。简体中文是 /zh-Hans/ 下的完整页面。语言切换始终可见，页面不自动跳转。',
    languageList: [
      '已翻译：界面、编码方法、编码位定义、能力名称、页面摘要、数据核查图注。',
      '不翻译：论文摘要。翻译摘要会产生演绎作品，本站不发布摘要。',
      '论文标题保留原文。如加译名，译名不替代原文。',
      '中文块标注 lang="zh-Hans"。版式用最长标签在 320px 下测试。',
    ],
    languageNote:
      '中英文页面共享一个数据文件与一套 ID。同一个数字不应在两种语言中不同；如果不同，以英文页的当前版本为准，并且这是一个 bug。',
    closeNote:
      '本站提供研究资料。项目内容不构成同行评审、法律意见或对任何论文、作者、期刊、方法的背书。',
  },
};

const c = copy[lang];
---

<ContentPage
  lang={lang}
  slug="/about/"
  title={c.title}
  description={c.description}
  eyebrow={c.eyebrow}
  heading={c.heading}
  lede={c.lede}
  factsTitle={c.factsTitle}
  facts={c.facts}
  sections={c.sections}
>
  <section id="what">
    <div class="sec-head">
      <div><h2>{c.whatTitle}</h2></div>
      <p>{c.whatBody}</p>
    </div>
    <ul class="prose">
      {c.whatList.map((item) => <li>{item}</li>)}
    </ul>
    <p class="note note--accent">{c.whatNote}</p>
  </section>

  <section id="status">
    <div class="sec-head">
      <div><h2>{c.statusTitle}</h2></div>
      <p>{c.statusBody}</p>
    </div>
    <dl class="contact-list">
      {c.statusList.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd class="mono">{v}</dd>
        </>
      ))}
    </dl>
  </section>

  <section id="team">
    <div class="sec-head">
      <div><h2>{c.teamTitle}</h2></div>
      <p>{c.teamBody}</p>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">{c.colRole}</th>
            <th scope="col">{c.colOwns}</th>
            <th scope="col">{c.colArtifacts}</th>
          </tr>
        </thead>
        <tbody>
          {team.map((row) => {
            const [role, owns, artifacts] = lang === 'zh' ? row.zh : row.en;
            return (
              <tr>
                <td>{role}</td>
                <td>{owns}</td>
                <td>{artifacts}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="note">{c.teamNote}</p>
  </section>

  <section id="citation">
    <div class="sec-head">
      <div><h2>{c.citationTitle}</h2></div>
      <p>{c.citationBody}</p>
    </div>
    <blockquote class="quote" style="font-size:0.86rem">{c.citationPlain}</blockquote>
    <p class="small" style="margin-top:0.8rem">
      <a href={withBase(lang === 'zh' ? '/zh-Hans/download/#citation' : '/download/#citation')}>
        {lang === 'en' ? 'Plain citation and BibTeX' : '纯文本引用与 BibTeX'}
      </a>
    </p>
  </section>

  <section id="license">
    <div class="sec-head">
      <div><h2>{c.licenseTitle}</h2></div>
      <p>{c.licenseBody}</p>
    </div>
    <p class="note">{c.licenseNote}</p>
    <p class="small" style="margin-top:0.8rem">
      <a href={withBase(lang === 'zh' ? '/zh-Hans/responsibility/' : '/responsibility/')}>
        {lang === 'en' ? 'Full license and responsibility notice' : '完整许可与责任说明'}
      </a>
    </p>
  </section>

  <section id="contact">
    <div class="sec-head">
      <div><h2>{c.contactTitle}</h2></div>
    </div>
    <dl class="contact-list">
      {c.contactRows.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))}
    </dl>
    <p class="note" style="margin-top:1rem">
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      {' · '}
      <a href={githubUrl}>GitHub</a>
      {' · '}
      <a href={githubIssuesUrl}>Issues</a>
    </p>
    <p class="small" style="margin-top:0.8rem">
      <a href={withBase(lang === 'zh' ? '/zh-Hans/newsletter/' : '/newsletter/')}>
        {lang === 'en' ? 'Newsletter status' : '订阅状态'}
      </a>
    </p>
  </section>

  <section id="language">
    <div class="sec-head">
      <div><h2>{c.languageTitle}</h2></div>
      <p>{c.languageBody}</p>
    </div>
    <ul class="prose">
      {c.languageList.map((item) => <li>{item}</li>)}
    </ul>
    <p class="note">{c.languageNote}</p>
    <p class="note note--accent">{c.closeNote}</p>
  </section>
</ContentPage>
