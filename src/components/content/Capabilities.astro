---
import ContentPage from '../ContentPage.astro';
import { atlas, arxivUrl } from '../../lib/atlas';
import { labels } from '../../lib/labels';
import { citationHref, clipQuote } from '../../lib/content';
import { withBase } from '../../lib/urls';
import type { Capability, CapabilityEvidence } from '../../lib/types';

interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;
const L = labels[lang] as any;

const zhNames: Record<string, string> = {
  F1: 'SCM 与 do-calculus',
  F2: '潜在结果',
  F3: '图模型 / d-分离',
  F4: '反事实逻辑',
  F5: '独立机制',
  I1: '后门调整',
  I2: '前门调整',
  I3: '一般识别（ID）',
  I4: '可交换性 / 无混杂',
  I5: '正值性 / 重叠',
  I6: '一致性与 SUTVA',
  I7: '工具变量',
  I8: '断点回归',
  I9: '双重差分',
  I10: '合成控制',
  I11: '选择模型',
  I12: '可迁移性',
  I13: '中介 / 直接与间接效应',
  I14: '近端因果 / 阴性对照',
  I15: '主分层',
  I16: '部分识别',
  I17: '敏感性分析',
  I18: '目标试验模拟',
  E1: '匹配 / 倾向得分',
  E2: 'IP 加权 / MSM',
  E3: '标准化 / g-formula',
  E4: 'G-estimation / SNMM',
  E5: '双重稳健 / AIPW / TMLE',
  E6: '双重机器学习',
  E7: '异质效应',
  E8: 'Super learner / 灵活估计',
  D1: '约束式发现（PC/FCI）',
  D2: '评分式发现（GES/NOTEARS）',
  D3: '函数因果模型（LiNGAM/ANM）',
  D4: '干预式发现',
  D5: '时间序列发现',
  D6: '可识别因果表示',
};

const capName = (c: Capability) => (lang === 'zh' ? (zhNames[c.id] ?? c.name) : c.name);

const caps = atlas.capabilities;
const total = caps.length;
const layers = ['framework', 'identify', 'estimate', 'discover'] as const;
const layerList = layers.map((key) => ({
  key,
  items: caps.filter((c) => c.layer === key),
}));

const lifecycle = ['Data / Representation', 'Training / Model', 'Inference / Agent'] as const;
const cellMembers = (cell: string) =>
  caps.filter((c) => c.cell.split(';').map((x) => x.trim()).includes(cell));

const copy = {
  en: {
    title: 'Causal methods',
    description:
      '37 causal methods organized by data, training, and inference. Each row gives the problem, assumptions, interface, failure mode, and representative work.',
    eyebrow: '03 / Causal methods',
    heading: 'Causal methods',
    lede: 'How causal methods help AI',
    sections: [
      ['frame', '2 × 3 frame'],
      ['rows', 'Causal methods'],
    ] as Array<[string, string]>,
    frameTitle: 'A 2 × 3 frame',
    frameBody:
      'Rows separate two directions of work. Columns are the three lifecycle stages. The upper row holds the 37 causal capabilities; the lower row holds the mirror agenda for AI serving causality. Open any row for its problem, assumptions, interface, and representative work.',
    directionHead: 'Direction',
    mirrorTitle: 'AI → Causality (agenda, not counted)',
    mirror: [
      [
        'Data / Representation',
        'LLM priors over graphs; text and domain knowledge as constraints. D1, D2, D3, D5 are the receiving methods.',
      ],
      [
        'Training / Model',
        'Neural structure learning and hybrid identification. D4 is the receiving method.',
      ],
      [
        'Inference / Agent',
        'Agents that choose experiments, run closed-loop discovery, and verify their own causal claims.',
      ],
    ],
    rowsTitle: 'Causal methods',
    fieldProblem: 'Problem',
    fieldAssumptions: 'Assumptions',
    fieldInterface: 'Interface',
    fieldFailure: 'Failure mode',
    fieldCitation: 'Citation',
    fieldExemplars: 'Representative works',
    evidence: 'Evidence',
    exemplar: 'Exemplar',
    aclCase: 'ACL / LLM case',
    negativeCase: 'Negative / cautionary',
    whenNot: 'When not to use',
    notes: 'Notes',
    evidenceSummary: (n: number) => `Evidence · ${n} exemplars · 1 ACL/LLM case · 1 negative case`,
    downloadLabel: 'Download atlas.json',
  },
  zh: {
    title: '因果方法',
    description:
      '37 条因果方法，按数据、训练、推理三个环节组织。每条给出问题、假设、接口、失效模式和代表工作。',
    eyebrow: '03 / 因果方法',
    heading: '因果方法',
    lede: '因果方法怎么帮助AI',
    sections: [
      ['frame', '2 × 3 框架'],
      ['rows', '因果方法'],
    ] as Array<[string, string]>,
    frameTitle: '2 × 3 框架',
    frameBody:
      '行是两个工作方向，列是三个应用环节。上排放 37 条因果能力，下排放 AI 服务因果的辅助方向。点开任意一行，查看它的问题、假设、接口和代表工作。',
    directionHead: '方向',
    mirrorTitle: 'AI → 因果（辅助方向，不计入）',
    mirror: [
      [
        '数据 / 表示',
        'LLM 的图先验；文本与领域知识作为约束。D1、D2、D3、D5 是对应方法。',
      ],
      ['训练 / 模型', '神经结构学习与混合识别。D4 是对应方法。'],
      ['推理 / Agent', '由 agent 选择实验、执行闭环发现，并校验自己的因果主张。'],
    ],
    rowsTitle: '因果方法',
    fieldProblem: '问题',
    fieldAssumptions: '假设',
    fieldInterface: '接口',
    fieldFailure: '失效模式',
    fieldCitation: '引用',
    fieldExemplars: '代表工作',
    evidence: '证据',
    exemplar: '代表工作',
    aclCase: 'ACL / LLM 案例',
    negativeCase: '反例 / 警示',
    whenNot: '何时不应使用',
    notes: '备注',
    evidenceSummary: (n: number) => `证据 · ${n} 条代表工作 · 1 条 ACL/LLM 案例 · 1 条反例`,
    downloadLabel: '下载 atlas.json',
  },
};

const c = copy[lang];

const evidenceEntries = (ev: CapabilityEvidence) => [
  ...ev.exemplars.map((e) => ({ ...e, role: c.exemplar })),
  { ...ev.acl_llm_case, role: c.aclCase },
  { ...ev.negative_case, role: c.negativeCase },
];
---

<ContentPage
  lang={lang}
  slug="/capabilities/"
  title={c.title}
  description={c.description}
  eyebrow={c.eyebrow}
  heading={c.heading}
  lede={c.lede}
  sections={c.sections}
>
  <section id="frame">
    <div class="sec-head" style="grid-template-columns:1fr">
      <div>
        <h2>{c.frameTitle}</h2>
      </div>
    </div>

    <div class="table-scroll">
      <table class="matrix">
        <thead>
          <tr>
            <th scope="col">{c.directionHead}</th>
            {lifecycle.map((cell) => (
              <th scope="col">
                {L.cell[cell]}
                <span class="matrix__count">
                  {' '}
                  · {cellMembers(cell).length}
                </span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{L.direction.cd_for_ai}</th>
            {lifecycle.map((cell) => {
              const items = cellMembers(cell);
              return (
                <td data-label={`${L.cell[cell]} · ${items.length}`}>
                  <span class="matrix__ids">
                    {items.map((cap) => (
                      <a href={`#${cap.id}`} title={capName(cap)} aria-label={`${cap.id} ${capName(cap)}`}>{cap.id}</a>
                    ))}
                  </span>
                  {cell === 'Data / Representation' && (
                    <p class="matrix__note">+ I1 (Data + Evaluation)</p>
                  )}
                </td>
              );
            })}
          </tr>
          <tr>
            <th scope="row">{L.direction.ai_for_cd}</th>
            {c.mirror.map(([cell, text]) => (
              <td data-label={L.cell[cell]}>
                <p class="matrix__note" style="margin-top:0">{text}</p>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="rows">
    <div class="sec-head">
      <div>
        <h2>{c.rowsTitle}</h2>
      </div>
    </div>

    {layerList.map(({ key, items }) => (
      <>
        <h3 class="layer-head">
          {L.layer[key]}
          <span>{items.length} / {total}</span>
        </h3>
        {items.map((cap) => (
          <article class="cap" id={cap.id}>
            <div class="cap__head">
              <span class="cap__id">{cap.id}</span>
              <h4 class="cap__name">{capName(cap)}</h4>
              <span class="cap__tags">
                <span class="tag">{L.layer[cap.layer]}</span>
                {cap.priority === 'P0' && <span class="tag tag--p0">{lang === 'zh' ? '优先' : 'Priority'}</span>}

              </span>
            </div>
            <dl class="cap__fields">
              <div class="cfield">
                <dt>{c.fieldProblem}</dt>
                <dd>{cap.problem}</dd>
              </div>
              <div class="cfield">
                <dt>{c.fieldAssumptions}</dt>
                <dd>{cap.assumptions}</dd>
              </div>
              <div class="cfield">
                <dt>{c.fieldInterface}</dt>
                <dd>{cap.interface}</dd>
              </div>
              <div class="cfield">
                <dt>{c.fieldFailure}</dt>
                <dd>{cap.failure_mode}</dd>
              </div>
            </dl>
            <p class="cap__cite">
              {c.fieldCitation}:{' '}
              <a href={citationHref(cap.citation_id)} rel="noopener noreferrer">
                {cap.citation_id}
              </a>
              <br />
              {c.fieldExemplars}: {cap.exemplars}
            </p>

            {cap.evidence && (
              <details class="evidence">
                <summary>
                  {c.evidenceSummary(cap.evidence.exemplars.length)}
                </summary>
                <div class="evidence__body">
                  {evidenceEntries(cap.evidence).map((e) => {
                    const href = arxivUrl(e.paper_id);
                    return (
                      <div class="ev-item">
                        <div class="ev-item__role">{e.role}</div>
                        <div>
                          <p class="ev-item__title">
                            {href ? (
                              <a href={href} rel="noopener noreferrer">{e.title}</a>
                            ) : (
                              e.title
                            )}
                          </p>
                          <p class="ev-item__meta">
                            {e.paper_id} · {e.family} · {e.year} · tier {e.tier} · {e.coupling_level}
                          </p>
                          <p class="ev-item__why">{e.why}</p>
                          <blockquote class="quote">
                            “{clipQuote(e.quote)}”
                            <cite>locator: {e.locator}</cite>
                          </blockquote>
                        </div>
                      </div>
                    );
                  })}
                  <p class="note note--accent" style="margin-top:0.9rem">
                    <strong>{c.whenNot}.</strong> {cap.evidence.when_not_to_use}
                  </p>
                  {cap.evidence.notes && (
                    <p class="small" style="margin-top:0.6rem">
                      <strong>{c.notes}.</strong> {cap.evidence.notes}
                    </p>
                  )}
                </div>
              </details>
            )}
          </article>
        ))}
      </>
    ))}
    <p class="small" style="margin-top:1rem">
      <a href={withBase(lang === 'zh' ? '/zh-Hans/download/' : '/download/')}>{c.downloadLabel}</a>
    </p>
  </section>
</ContentPage>
