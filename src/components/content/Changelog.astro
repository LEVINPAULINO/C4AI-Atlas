---
import ContentPage from '../ContentPage.astro';
import { dataVersion, builtDate } from '../../lib/content';

interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    title: 'Changelog',
    description: 'Data and site releases for C4AI Atlas.',
    eyebrow: '10 / Changelog',
    heading: 'What changed, and when',
    lede: `Data releases use semantic versioning. A frozen release gets a DOI. The current snapshot is v${dataVersion}.`,
    sections: [
      ['v030', 'v0.3.0'],
      ['v010', 'v0.1.0 (earlier release)'],
      ['rules', 'Release rules'],
    ] as Array<[string, string]>,
    currentTitle: `v${dataVersion}`,
    currentDate: builtDate,
    currentLabel: 'Current release · data status v7-canonical',
    added: 'Added',
    currentAdded: [
      '580-paper public coding snapshot.',
      '64 observed 8-bit patterns.',
      '37 capability rows; 15 are priority-ready with evidence tables.',
      '18 multi-genre records.',
      'English and Simplified Chinese routes.',
      'Warm-paper site redesign and a new mark.',
    ],
    changed: 'Changed',
    currentChanged: [
      'Data status is v7-canonical.',
      `Data snapshot rebuilt on ${builtDate}.`,
      'Subpage copy and metadata were revised.',
      'No API. Public data is versioned static JSON.',
    ],
    known: 'Known',
    currentKnown: [
      'Newsletter provider is not connected.',
      'A DOI is not assigned yet.',
      'Full evidence quotations are not in the public snapshot.',
    ],
    earlierTitle: 'v0.1.0',
    earlierDate: '2026-10-28',
    earlierLabel: 'Earlier release, kept for history',
    earlierAdded: [
      'First public 580-paper coding snapshot.',
      '64 observed 8-bit patterns.',
      '37 capability rows with 15 priority evidence tables.',
      'Fingerprint Ledger, Hamming lattice, UMAP, 3D orbital, PCA, UpSet, parallel coordinates.',
      'English and Simplified Chinese routes.',
      'Responsibility, methods, download, newsletter, changelog, and about pages.',
      'GitHub Pages workflow and static data snapshot.',
    ],
    earlierChanged: [
      'First public site design.',
      'No custom domain in v1.',
      'No API. Public data is versioned static JSON.',
    ],
    earlierKnown: [
      'Newsletter provider is not connected.',
      'A DOI was not assigned at that release.',
      'Full evidence quotations are not in the public snapshot.',
    ],
    rulesTitle: 'Release rules',
    rules: [
      'Patch: text, link, or layout correction with no change to the data.',
      'Minor: new records, new capability evidence, or a new view that does not break the schema.',
      'Major: schema change or a change to the coding rules.',
      'Every release states its record count, data version, and SHA-256.',
      'A frozen release is tagged and archived. The DOI goes in CITATION.cff.',
    ],
  },
  zh: {
    title: '版本历史',
    description: 'C4AI Atlas 的数据与站点发布记录。',
    eyebrow: '10 / 版本历史',
    heading: '版本记录',
    lede: `数据发布使用语义化版本；冻结版本会申请 DOI。当前快照为 v${dataVersion}。`,
    sections: [
      ['v030', 'v0.3.0'],
      ['v010', 'v0.1.0（历史版本）'],
      ['rules', '发布规则'],
    ] as Array<[string, string]>,
    currentTitle: `v${dataVersion}`,
    currentDate: builtDate,
    currentLabel: '当前版本 · 数据状态 v7-canonical',
    added: '新增',
    currentAdded: [
      '580 篇论文的公开编码快照',
      '64 种实际 8 位编码组合',
      '37 条能力；15 条优先能力附证据表',
      '18 条多类型记录',
      '英文与简体中文路由',
      '暖纸主题改版与新标识',
    ],
    changed: '变更',
    currentChanged: [
      '数据状态为 v7-canonical',
      `数据快照更新至 ${builtDate}`,
      '子页面文案与页面描述已修订',
      '公开数据为带版本的静态 JSON 文件，不提供 API',
    ],
    known: '已知问题',
    currentKnown: [
      '订阅服务商尚未接入',
      '当前快照尚未分配 DOI',
      '完整证据引文不在公开快照中',
    ],
    earlierTitle: 'v0.1.0',
    earlierDate: '2026-10-28',
    earlierLabel: '历史版本，保留备查',
    earlierAdded: [
      '首个 580 篇论文公开编码快照',
      '64 种实际 8 位编码组合',
      '37 条能力，15 条优先能力证据',
      '编码总表、汉明图、UMAP 投影、三维旋转图、PCA、UpSet 和平行坐标',
      '英文与简体中文路由',
      '责任说明、编码方法、下载、订阅、版本历史、关于页面',
      'GitHub Pages workflow 与静态数据快照',
    ],
    earlierChanged: [
      '首个公开站点设计',
      'v1 不配置自定义域名',
      '公开数据为带版本的静态 JSON 文件，不提供 API',
    ],
    earlierKnown: [
      '订阅服务商尚未接入',
      '该版本尚未分配 DOI',
      '完整证据引文不在公开快照中',
    ],
    rulesTitle: '发布规则',
    rules: [
      'Patch：文字、链接或布局修正，不改数据。',
      'Minor：新增记录、新增能力证据、新增不破坏数据结构的视图。',
      'Major：数据结构变更或编码规则变更。',
      '每个版本都写记录数、数据版本和 SHA-256。',
      '冻结版本打 tag 并归档。DOI 写入 CITATION.cff。',
    ],
  },
} as const;

const c = copy[lang];
---
<ContentPage
  lang={lang}
  slug="/changelog/"
  title={c.title}
  description={c.description}
  eyebrow={c.eyebrow}
  heading={c.heading}
  lede={c.lede}
  sections={c.sections}
>
  <section id="v030">
    <div class="sec-head">
      <div>
        <h2>{c.currentTitle}</h2>
        <p class="mono-note">{c.currentDate} · {c.currentLabel}</p>
      </div>
    </div>
    <div class="change-grid">
      <div><h3>{c.added}</h3><ul>{c.currentAdded.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3>{c.changed}</h3><ul>{c.currentChanged.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3>{c.known}</h3><ul>{c.currentKnown.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>
  <section id="v010">
    <div class="sec-head">
      <div>
        <h2>{c.earlierTitle}</h2>
        <p class="mono-note">{c.earlierDate} · {c.earlierLabel}</p>
      </div>
    </div>
    <div class="change-grid">
      <div><h3>{c.added}</h3><ul>{c.earlierAdded.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3>{c.changed}</h3><ul>{c.earlierChanged.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3>{c.known}</h3><ul>{c.earlierKnown.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>
  <section id="rules">
    <div class="sec-head">
      <div><h2>{c.rulesTitle}</h2></div>
    </div>
    <ul>{c.rules.map((x) => <li>{x}</li>)}</ul>
  </section>
</ContentPage>
