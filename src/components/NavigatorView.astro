---
import Base from '../layouts/Base.astro';
import Navigator from './Navigator';
import type { Lang } from '../lib/i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const title = lang === 'zh' ? '问题导航 · C4AI Atlas' : 'Problem navigator · C4AI Atlas';
const desc = lang === 'zh'
  ? '从 AI 问题出发，映射到因果问题，再查看候选方法、假设和最小验证。'
  : 'Start from an AI problem, map it to a causal question, then see candidate methods, assumptions, and a minimal test.';
---
<Base lang={lang} title={title} description={desc} alternateHref={lang === 'zh' ? '/navigator/' : '/zh-Hans/navigator/'} switchHref={lang === 'zh' ? '/navigator/' : '/zh-Hans/navigator/'}>
  <div class="wrap">
    <Navigator client:load lang={lang} />
  </div>
</Base>
