---
import '../styles/global.css';
import { t, type Lang } from '../lib/i18n';
import { atlas } from '../lib/atlas';
import { withBase } from '../lib/urls';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  alternateHref: string;
  switchHref?: string;
  path?: string;
}

const { lang = 'en', title, description, alternateHref, switchHref, path = Astro.url.pathname } = Astro.props;
const c = t(lang);
const htmlLang = c.locale;
const prefix = lang === 'zh' ? '/zh-Hans' : '';
const nav = [
  ['explore', `${prefix}/explore/`],
  ['papers', `${prefix}/papers/`],
  ['navigator', `${prefix}/navigator/`],
  ['capabilities', `${prefix}/capabilities/`],
  ['audit', `${prefix}/audit/`],
  ['methods', `${prefix}/methods/`],
  ['deep', `${prefix}/deep/`],
] as const;
const canonical = new URL(path, Astro.site ?? 'https://levinpaulino.github.io').toString();
const alternate = new URL(withBase(alternateHref), Astro.site ?? 'https://levinpaulino.github.io').toString();
const defaultHref = lang === 'en' ? canonical : alternate;
const ogImage = new URL(withBase('/og.png'), Astro.site ?? 'https://levinpaulino.github.io').toString();

---
<!doctype html>
<html lang={htmlLang} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#F4F5F1" />
    <link rel="alternate" hreflang={lang === 'en' ? 'zh-Hans' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="C4AI Atlas" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Noto+Serif+SC:wght@400;600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        try {
          const param = new URLSearchParams(location.search).get('theme');
          const saved = localStorage.getItem('c4ai-theme');
          if (param === 'night' || param === 'day') document.documentElement.dataset.theme = param;
          else if (saved === 'night' || saved === 'day') document.documentElement.dataset.theme = saved;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={withBase(c.homeHref)} aria-label="C4AI Atlas home">
          <svg class="brand__mark" viewBox="0 0 18 28" aria-hidden="true">
            <path d="M9 2v24" stroke="currentColor" stroke-width="1.5" />
            <path d="M9 5H5M9 10h4M9 15H4M9 20h3M9 25H5" stroke="currentColor" stroke-width="1.5" />
            <path d="M9 15h7" stroke="var(--accent)" stroke-width="1.5" />
          </svg>
          <span>
            <span class="brand__word">C<span>4</span>AI <span style="color:var(--ink)">ATLAS</span></span>
            <span class="brand__sub">{c.brandSub}</span>
          </span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map(([key, href]) => (
            <a href={withBase(href)} aria-current={path === withBase(href) ? 'page' : undefined}>{c.nav[key]}</a>
          ))}
        </nav>
        <div class="tools">
          <a class="lang-button" href={withBase(switchHref ?? c.switchHref)} hreflang={lang === 'en' ? 'zh-Hans' : 'en'}>{c.switchLabel}</a>
          <button class="icon-button" type="button" data-theme-toggle aria-label={c.themeToggle} title={c.themeToggle}>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.2" />
              <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.1 3.1l1.4 1.4M11.5 11.5l1.4 1.4M12.9 3.1l-1.4 1.4M4.5 11.5l-1.4 1.4" stroke="currentColor" stroke-width="1.1" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div>
            <div class="brand__word" style="font-size:1rem">C<span style="color:var(--accent)">4</span>AI ATLAS</div>
            <p style="max-width:42ch;margin:0.8rem 0 0">{c.footer.note}</p>
            <p class="mono" style="margin-top:1rem;font-size:0.68rem">v0.1 provisional · {atlas.meta.protocol_version} · {atlas.meta.built_at.slice(0, 10)}</p>
          </div>
          <div>
            <h2 class="eyebrow">{c.footer.linksTitle}</h2>
            <ul>
              {c.footer.links.map(([label, href]) => <li><a href={withBase(href)}>{label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2 class="eyebrow">{c.footer.legalTitle}</h2>
            <ul>
              {c.footer.legal.map(([label, href]) => <li><a href={withBase(href)}>{label}</a></li>)}
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        document.documentElement.classList.add('js-reveal');
        const sections = [...document.querySelectorAll('.section, .stat, .cap-cell, .p0-item, .deep-links a, .pattern-preview__row')];
        if (!('IntersectionObserver' in window)) {
          sections.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -12% 0px' });
        sections.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        const els = [...document.querySelectorAll('[data-count]')];
        if (!els.length) return;
        const format = (n, decimals) => new Intl.NumberFormat('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        }).format(n);
        const animate = (el) => {
          const target = Number(el.dataset.count);
          const decimals = Number(el.dataset.decimals || 0);
          if (!Number.isFinite(target)) return;
          const start = performance.now();
          const duration = 900;
          const tick = (now) => {
            const p = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = format(target * eased, decimals);
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = format(target, decimals);
          };
          requestAnimationFrame(tick);
        };
        els.forEach((el, index) => {
          setTimeout(() => animate(el), index * 70);
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const set = (theme) => {
          root.dataset.theme = theme;
          try { localStorage.setItem('c4ai-theme', theme); } catch {}
        };
        if (button) button.addEventListener('click', () => set(root.dataset.theme === 'night' ? 'day' : 'night'));
      })();
    </script>
  </body>
</html>
